# Copy this file to .env and fill in your local paths.
# Paths can be absolute or relative to the project root.
# If a variable is not set, the program falls back to the default shown below.

# AADR annotation file — download from Reich Lab (see README for link)
AADR_PATH=data/aadr/AADR Annotations 2025.xlsx

# The following files are already included in the repository.
# You only need to change these if you move them to a different location.
VIP_PATH=data/vip/VIPHaplogroups.xlsx
MT_TREE_PATH=data/trees/mt_phyloTree_b17_Tree2.txt
Y_TREE_PATH=data/trees/chrY_hGrpTree_isogg2016.txt
Y_ALIAS_PATH=data/y_aliases.tsv
EARLY_N=5
